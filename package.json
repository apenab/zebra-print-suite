{
  "name": "zebra-print-suite-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter react-zebra-print build",
    "dev": "pnpm -r --parallel --filter react-zebra-print --filter demo run dev",
    "dev:watch": "pnpm --filter react-zebra-print run build:watch & pnpm --filter demo run dev",
    "test-react-zebra": "pnpm -r --filter react-zebra-print test",
    "test-zebra-web-bridge": "pnpm -r --filter zebra-web-bridge test",
    "coverage": "pnpm -r --filter react-zebra-print coverage",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.45.0"
  }
}
